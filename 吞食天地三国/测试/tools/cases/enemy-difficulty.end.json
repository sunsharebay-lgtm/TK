["(()=>{const s=T.BattleScene;const out={};const fails=[];const CHK=(k,v)=>{out[k]=v;if(v!==true)fails.push(k+':'+JSON.stringify(v));};if(!s)return JSON.stringify({allOk:false,fails:['no-battle']});const j=s.troop.members.find(e=>e.enemyId===20);j.hp=100;s.applyToBattler(j,T.$dataSkills[93],j);out.activeHeal=j.hp-100;CHK('activeHealReduced',out.activeHeal>=90&&out.activeHeal<=160&&out.activeHeal<300);j.hp=100;s.applyToBattler(j,T.$dataSkills[96],j);out.fullHeal=j.hp;CHK('completeHeal',j.hp===j.mhp);j.hp=j.mhp-100;const hp1=j.hp;j.onTurnEnd();out.passiveHeal=j.hp-hp1;CHK('noPassiveHeal',j.xparam(7)===0&&j.xparam(8)===0&&out.passiveHeal===0);j.hp=100;j.mp=5;j.actions=[{skillId:93,rating:7,conditionType:0}];s.doEnemyAction(j);out.healTarget=s.actionVisual&&s.actionVisual.target===j;CHK('mpConsumed',j.mp===5-T.skillCost(T.$dataSkills[93]));j.actions=[{skillId:93,rating:7,conditionType:0},{skillId:1,rating:5,conditionType:0}];out.resourceFallback=s.selectEnemyAction(j);CHK('mpExhaustedAttack',out.resourceFallback&&out.resourceFallback.skillId===1);out.tacticRates=[s.enemyTacticRate({mat:50}),s.enemyTacticRate({mat:200})];CHK('intelligenceRaisesRate',out.tacticRates[1]>out.tacticRates[0]);out.effectByInt=[s.enemyDamageValue({mat:50},T.$dataSkills[69],j),s.enemyDamageValue({mat:200},T.$dataSkills[69],j)];CHK('intelligenceRaisesEffect',out.effectByInt[1]>out.effectByInt[0]);out.expRate=T.BATTLE_EXP_RATE;CHK('expBoost',out.expRate===1.25);out.allOk=fails.length===0;out.fails=fails;return JSON.stringify(out);})()"]
