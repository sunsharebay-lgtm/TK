["(()=>{const s=T.BattleScene;const side=(list)=>{const ref=Math.max(1,...list.map(b=>b.hp));return list.map(b=>Math.round(Math.max(0,Math.min(1,b.hp/ref))*100));};const enemy=side(s.troop.members);const party=side(s.partyMembers);return JSON.stringify({enemy,party,enemyRef:Math.max(...s.troop.members.map(e=>e.hp)),partyRef:Math.max(...s.partyMembers.map(a=>a.hp)),allOk:enemy.includes(100)&&party.includes(100)});})()"]
