["(()=>{const s=T.BattleScene;const out={};const fails=[];const CHK=(k,v)=>{out[k]=v;if(v!==true)fails.push(k+':'+JSON.stringify(v));};if(!s)return JSON.stringify({allOk:false,fails:['no-battle']});const e=s.troop.aliveMembers()[0];s.partyMembers.forEach(x=>x.xparam=()=>0);e.actions=[{skillId:1,rating:5,conditionType:0}];const hpBefore=s.partyMembers.map(x=>[x,x.hp]);s.doEnemyAction(e);const normalTarget=s.actionVisual&&s.actionVisual.target;out.normalTarget=normalTarget&&normalTarget.name;CHK('normalTargetIsActor',s.partyMembers.includes(normalTarget));out.hpLoss=hpBefore.reduce((n,[x,hp])=>n+(hp-x.hp),0);CHK('normalEnemyHits',out.hpLoss>0);s.totalAssaultActive=true;s.issueTotalAssaultActions();const totalBefore=s.partyMembers.map(x=>[x,x.hp]);s.doEnemyAction(e);const totalTarget=s.actionVisual&&s.actionVisual.target;out.totalTarget=totalTarget&&totalTarget.name;CHK('totalTargetIsActor',s.partyMembers.includes(totalTarget));out.totalHpLoss=totalBefore.reduce((n,[x,hp])=>n+(hp-x.hp),0);CHK('totalEnemyHits',out.totalHpLoss>0);out.allOk=fails.length===0;out.fails=fails;return JSON.stringify(out);})()"]
