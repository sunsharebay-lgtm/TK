["(()=>{const s=T.BattleScene;const out={};const fails=[];const CHK=(k,v)=>{out[k]=v;if(v!==true)fails.push(k+':'+JSON.stringify(v));};if(!s)return JSON.stringify({allOk:false,fails:['no-battle']});const enemyMax=s.troop.members.reduce((a,e)=>e.hp>a.hp?e:a,s.troop.members[0]);const partyMax=s.partyMembers.reduce((a,e)=>e.hp>a.hp?e:a,s.partyMembers[0]);const er=s.enemyBarRefHp,pr=s.partyBarRefHp;const eBefore=enemyMax.hp,pBefore=partyMax.hp;enemyMax.hp=Math.max(1,eBefore-100);partyMax.hp=Math.max(1,pBefore-100);out.refs=[er,pr];out.rates=[s.enemyBarRate(enemyMax),s.partyBarRate(partyMax)];out.expected=[enemyMax.hp/er,partyMax.hp/pr];CHK('enemyRefFrozen',er===eBefore&&s.enemyBarRefHp===er);CHK('partyRefFrozen',pr===pBefore&&s.partyBarRefHp===pr);CHK('enemyDamageOnly',Math.abs(out.rates[0]-out.expected[0])<0.001);CHK('partyDamageOnly',Math.abs(out.rates[1]-out.expected[1])<0.001);const actor=s.partyMembers[0],enemy=s.troop.members[0];s.totalAssaultActive=true;CHK('totalActorForward',s.actorMoveX(actor)===18);CHK('totalEnemyForward',s.enemyMoveX(enemy)===-18);s.totalAssaultActive=false;const j=s.troop.members.find(e=>e.enemyId===20);if(j){const hp0=j.hp;j.hp=Math.max(1,j.hp-100);j.onTurnEnd();out.jilingRegen=j.hp-(hp0-100);CHK('jilingRegenCap',j.xparam(7)<=0.1&&out.jilingRegen<=Math.ceil(j.mhp*0.1));}out.allOk=fails.length===0;out.fails=fails;return JSON.stringify(out);})()"]
