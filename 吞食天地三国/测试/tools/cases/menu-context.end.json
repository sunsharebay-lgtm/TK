["(()=>{const sc=T.SceneManager.current();const out={scene:sc&&sc.constructor.name,panels:[]};const fails=[];if(!sc||out.scene!=='Scene_Menu')fails.push('menu-not-open');if(T.Input.KEYMAP.KeyU!=='pageup')fails.push('u-key');if(T.Input.KEYMAP.KeyI!=='pagedown')fails.push('i-key');for(let i=0;i<sc.commands.length;i++){sc.commandWindow.index=i;try{sc.draw(T.mainCtx);out.panels.push(sc.commands[i]);}catch(e){fails.push(sc.commands[i]+':'+e.message);}}out.allOk=fails.length===0&&out.panels.length===sc.commands.length;out.fails=fails;return JSON.stringify(out);})()"]
